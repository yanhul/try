{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "try-aios-repair-provider",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "REPAIR_CHECKPOINTS",
        "class_name": "RepairCheckpoint"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepairCheckpoint"
      ]
    }
  ]
}
